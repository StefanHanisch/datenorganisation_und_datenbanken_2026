# Copy to .env and CHANGE passwords before publishing any service.
POSTGRES_OWNER_PASSWORD=owner_local_change
HOTEL_APP_PASSWORD=app_local_change
HOTEL_STUDENT_PASSWORD=student_local_change
DATABASE_URL=postgresql://hotel_app:app_local_change@localhost:5433/hoteldb
STUDENT_DATABASE_URL=postgresql://hotel_student:student_local_change@localhost:5433/hoteldb
SEED_DATABASE_URL=postgresql://hotel_owner:owner_local_change@localhost:5433/hoteldb
SESSION_SECRET=replace-with-at-least-32-random-characters-please
STUDENT_ACCESS_CODE=class-only-change-me
TEACHER_ACCESS_CODE=teacher-only-change-me
COOKIE_SECURE=false
SQL_STATEMENT_TIMEOUT_MS=4000
SQL_MAX_ROWS=100
