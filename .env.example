# Copy to .env and CHANGE passwords before publishing any service.

# ===========================================================================
# ZIEL-DATENBANK - nur diese eine Zeile aendern:
#   local = Docker-DB (localhost:5433, im Container der Service "db")
#   azure = Azure PostgreSQL (siehe AZURE_*-URLs unten)
# App, seed.py, export_analytics.py, benchmark_email.py und das Analytics-Notebook
# folgen dieser Variable. Fehlt sie, gelten wie frueher DATABASE_URL & Co.
# ===========================================================================
DB_TARGET=local

# ---------------------------------------------------------------------------
# 1) LOKAL (Docker Compose)
# ---------------------------------------------------------------------------
POSTGRES_OWNER_PASSWORD=owner_local_change
HOTEL_APP_PASSWORD=app_local_change
HOTEL_STUDENT_PASSWORD=student_local_change
LOCAL_DATABASE_URL=postgresql://hotel_app:app_local_change@localhost:5433/hoteldb
LOCAL_STUDENT_DATABASE_URL=postgresql://hotel_student:student_local_change@localhost:5433/hoteldb
LOCAL_SEED_DATABASE_URL=postgresql://hotel_owner:owner_local_change@localhost:5433/hoteldb
# Nur-Lese-Zugang fuer das Analytics-Notebook (Schema analytics, 60 s Timeout)
HOTEL_ANALYST_PASSWORD=analyst_local_change
LOCAL_ANALYST_DATABASE_URL=postgresql://hotel_analyst:analyst_local_change@localhost:5433/hoteldb

# ---------------------------------------------------------------------------
# 2) AZURE PostgreSQL Flexible Server
#    Platzhalter <...> ersetzen. Passwoerter stehen direkt in der URL (keine ${VARS});
#    Sonderzeichen URL-kodieren, z.B. @ -> %40, # -> %23.
#    Die Rollen hotel_app / hotel_student / hotel_owner und die DB "hoteldb" muessen
#    auf dem Server vorher vom Teacher angelegt sein (siehe db/init/).
# ---------------------------------------------------------------------------
AZURE_DATABASE_URL=postgresql://hotel_app:<APP_PASSWORD>@<server-name>.postgres.database.azure.com:5432/hoteldb?sslmode=require
AZURE_STUDENT_DATABASE_URL=postgresql://hotel_student:<STUDENT_PASSWORD>@<server-name>.postgres.database.azure.com:5432/hoteldb?sslmode=require
AZURE_SEED_DATABASE_URL=postgresql://hotel_owner:<OWNER_PASSWORD>@<server-name>.postgres.database.azure.com:5432/hoteldb?sslmode=require
# Nur-Lese-Zugang fuer das Analytics-Notebook (Schema analytics, 60 s Timeout).
# Diese URL bekommen die Studierenden.
AZURE_ANALYST_DATABASE_URL=postgresql://hotel_analyst:<ANALYST_PASSWORD>@<server-name>.postgres.database.azure.com:5432/hoteldb?sslmode=require

# ---------------------------------------------------------------------------
# 3) AZURE CLI / Admin-Verbindung (az postgres flexible-server connect, Notebook)
#    Beispiel:
#    set -a; source .env; set +a
#    az postgres flexible-server connect -n "$AZURE_PG_SERVER" \
#       -u "$AZURE_PG_ADMIN_USER" -p "$AZURE_PG_ADMIN_PASSWORD" -d "$AZURE_PG_DB"
# ---------------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_RESOURCE_GROUP=<resource-group>
AZURE_PG_SERVER=<server-name>
AZURE_PG_HOST=<server-name>.postgres.database.azure.com
AZURE_PG_PORT=5432
AZURE_PG_DB=postgres
AZURE_PG_ADMIN_USER=<admin-user>
AZURE_PG_ADMIN_PASSWORD=
AZURE_PG_SSLMODE=require

# connect_do_db.ipynb liest diese Variablen (Azure-Admin-Zugang)
DB_HOST=<server-name>.postgres.database.azure.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=<admin-user>
DB_PASSWORD=
DB_SSLMODE=require

# ---------------------------------------------------------------------------
# 4) App
# ---------------------------------------------------------------------------
SESSION_SECRET=replace-with-at-least-32-random-characters-please
STUDENT_ACCESS_CODE=class-only-change-me
TEACHER_ACCESS_CODE=teacher-only-change-me
COOKIE_SECURE=false
SQL_STATEMENT_TIMEOUT_MS=4000
SQL_MAX_ROWS=100
